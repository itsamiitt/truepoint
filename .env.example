# TruePoint — environment shape (documents keys only; never commit real values).
# Validated at boot by packages/config (appEnvSchema). Copy to .env for local dev.

NODE_ENV=development

# ── Auth service boundary (17 / ADR-0016) ───────────────────────────────────────────────────────────
# The dedicated identity origin and the app origins it issues tokens to (same-site under truepoint.in).
AUTH_ORIGIN=https://auth.truepoint.in
# Comma-separated CORS allow-list for /token/* — explicit origins only, NEVER a wildcard.
# Must list EVERY app origin that signs in, not just the customer app: appOrigins() feeds both the CORS
# allow-list AND the JWT *audience* check (apps/api middleware/authn.ts, apps/forge-api middleware/auth.ts),
# so an origin missing here cannot authenticate at all. deploy/env.production.template already lists all three.
APP_ORIGINS=https://app.truepoint.in,https://admin.truepoint.in,https://forge.truepoint.in
# Host-only cookie domain for the refresh cookie (scoped to the auth origin).
AUTH_COOKIE_DOMAIN=auth.truepoint.in
# Client-IP binding posture for the cross-domain code (ADR-0016 addendum): prefix (default; same /24·/64,
# robust to dual-stack first-hop drift) | strict (exact normalized IP) | off (rely on PKCE + single-use TTL).
AUTH_BIND_IP=prefix

# Token lifetimes (seconds). Access = in-memory JWT; code = single-use cross-domain handoff.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_CODE_TTL_SECONDS=60

# JWT signing (asymmetric, EdDSA). Private key signs on auth.*; JWKS publishes the public set.
# In production these come from Secrets Manager (KMS); locally use dev keys.
JWT_SIGNING_KID=dev-2026-06
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
# Base64 single-line transport for the PEMs — preferred for container deploys: a multi-line PEM loses its
# newlines through docker compose ${VAR} interpolation. deploy.sh sets these from deploy/keys/. Raw PEM wins
# if non-empty. e.g. JWT_PRIVATE_KEY_PEM_B64="$(base64 -w0 deploy/keys/jwt_private.pem)".
JWT_PRIVATE_KEY_PEM_B64=
JWT_PUBLIC_KEY_PEM_B64=

# ── Bootstrap platform admin (ADR-0032) ──────────────────────────────────────────────────────────────
# Provisioned by apps/auth bootstrapAdmin.ts. REQUIRED, no default — the seed FAILS CLOSED if either is
# unset. Set real values in .env (never commit) and rotate the password after first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ── Data plane ───────────────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://leadwolf:leadwolf@localhost:5432/leadwolf
# Non-BYPASSRLS application role (RLS enforced); distinct from any privileged admin role.
DATABASE_APP_ROLE=leadwolf_app
REDIS_URL=redis://localhost:6379

# HMAC key for email/domain blind indexes + token hashing (KMS-wrapped in prod).
BLIND_INDEX_KEY=dev-blind-index-key-change-me

# ── Local infra (docker-compose) ─────────────────────────────────────────────────────────────────────
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=dev
SMTP_URL=smtp://localhost:1025

# RFC 9457 problem-details `type` namespace rendered in API error responses. A stable identifier (need not
# resolve to a live page); trailing slash required. Defaults to https://truepoint.in/errors/ if unset.
ERROR_TYPE_BASE_URL=https://truepoint.in/errors/

# ── Web apps (NEXT_PUBLIC_* are build-inlined + browser-visible; non-secret origins only) ─────────────
# Local dev ports: auth 3000 · api 3001 · web 3002 (override these to http://localhost:<port>).
NEXT_PUBLIC_AUTH_ORIGIN=https://auth.truepoint.in
NEXT_PUBLIC_APP_ORIGIN=https://app.truepoint.in
NEXT_PUBLIC_API_BASE=https://api.truepoint.in

# ── CRM bidirectional sync (crm-sync 00 §5.3 / §7.2 / §10.5) — DARK by default ───────────────────────
# Dedicated data key for the CRM OAuth-bundle store (core/crm/crmSecretStore). Deliberately NOT the email
# or PII key: one key per credential class, so a compromise never widens and a rotation stays scoped.
# Unset in dev/test → derived from BLIND_INDEX_KEY. Production MUST inject a KMS-managed key — a real
# CMK-wrapped DEK is the hard prerequisite before any production CRM token is stored (00 §7.2/§11).
CRM_SECRET_KEY=

# L1 of the three-gate ladder — the GLOBAL kill switch. Explicit "true" only. While off the sweep does not
# take its leader lock and every runner returns `gated`. L2 is the per-tenant `crm_sync_enabled` flag and
# L3 is the per-connection sync_mode (default 'shadow'), so setting this alone still moves NO data.
CRM_SYNC_ENABLED=false

# How far back a delta poll reads from the stored watermark. CRM modstamps are not ordered against our
# clock, so a record written during the previous poll can carry a timestamp just under the mark. Re-reading
# a record is free (link table + content hash make it a no-op); missing one is silent data loss.
CRM_SYNC_OVERLAP_MS=300000

# Fan-out cap per sweep tick. A connection still due after the cap is picked up next tick.
CRM_SYNC_MAX_CONNECTIONS_PER_SWEEP=500

# Per-provider inbound webhook signing secrets. The public webhook route FAILS CLOSED without one — no
# secret means every event for that provider is rejected, never accepted unsigned. A passing signature is
# the only thing proving a request came from the provider, and is what makes the account id in the body
# safe to use for selecting a connection.
CRM_HUBSPOT_WEBHOOK_SECRET=
CRM_SALESFORCE_WEBHOOK_SECRET=

# The OAuth redirect URI handed to the provider. Must exactly equal a URI registered in the provider's app.
CRM_OAUTH_REDIRECT_URI=https://app.truepoint.in/settings/crm/callback
