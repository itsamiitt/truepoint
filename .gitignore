# Claude Code hook state (not source; per-machine)
.claude/.arch-map-nudge

# Node / Turborepo (the planned monorepo stack — ignored ahead of first code)
node_modules/
dist/
build/
.next/
.turbo/
coverage/

# Env & secrets (never commit real values; .env.example documents the shape)
.env
.env.*
!.env.example

# Deploy-time secrets — generated on the server, never committed.
deploy/keys/

# Drizzle migrations are now GENERATED in dev (`bun run --filter @leadwolf/db generate`) and COMMITTED —
# prod APPLIES them deterministically (no generate at deploy time, which could hang/prompt on the host).
# So packages/db/src/migrations/ is tracked on purpose; do not re-ignore it.

# Next.js generated type reference (per-build, like .next/)
next-env.d.ts

# TypeScript incremental-build state (written by tsc --noEmit with incremental projects)
*.tsbuildinfo

# claude.ai/design sync (/design-sync) — staging scripts, generated bundles, scratch build, machine state.
# The durable inputs under .design-sync/ (config*.json, NOTES.md, conventions*.md, previews/, apps/, lib/,
# stubs/, build-app.mjs) ARE committed; everything below is regenerated per run / per clone.
# One output dir per app now: ds-bundle (web) + ds-bundle-{admin,forge,auth,extension}.
.ds-sync/
ds-bundle/
ds-bundle-*/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
packages/ui/.ds-tsconfig.json
.ds-prospect-tsconfig.json
.ds-app-tsconfig.json
# (the scratch built-package goes in packages/ui/dist/ — already covered by the dist/ rule above,
#  and excluded from the architecture-map scan, which skips dist/ segments)

# Redis snapshot artifacts — a local redis-server writes dump.rdb into the repo root. It was tracked from
# commit 54c937a; it is data, not source, and can contain whatever the dev instance held.
*.rdb

# Dev secrets generated on first boot by start.sh (Ed25519 signing key, blind-index key, bootstrap password).
# Generated per machine so two developers never share a signing key — never commit this.
.dev-secrets.env

# Local data drops handed to an agent or a developer as working material — provider payload samples, export
# extracts, anything pasted in to reason about. `source plan/` is the current one: six real LinkedIn profile
# and company payloads (named individuals, employment histories, member ids). Same reasoning as *.rdb above —
# it is data, not source — but with sharper stakes: committing a real person's record publishes it into git
# history, where deleting it means rewriting a shared history rather than a revert. The whole point of the
# suppression and provenance machinery in this repo is that such records do not spread, and a stray
# `git add -A` is the likeliest way one would.
#
# Verified never committed (git log --all -- "source plan/" is empty) at the time this rule was added.
# Ignoring does NOT delete anything: the files stay on disk and stay usable as a test oracle.
source plan/

# Spreadsheet + CSV drops. These are THIS product's PII formats in both directions: bulk contact export,
# audit-log export and billing export all write CSV, and the import path takes CSV/XLSX uploads — so testing
# either end locally leaves a file of real revealed contacts sitting in the tree. Zero .csv/.xlsx/.xls files
# are tracked today, so this costs nothing and closes the same hole as the `source plan/` rule above.
#
# If a genuine FIXTURE is ever needed (a tiny, synthetic, reserved-domain sample — ADR-0048 D5 discipline),
# un-ignore it explicitly rather than weakening the rule:  !packages/db/test/fixtures/whatever.csv
*.csv
*.xlsx
*.xls
