{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "ignore": [
      "**/dist",
      "**/.next",
      "**/.turbo",
      ".claude",
      ".design-sync",
      "**/src/migrations",
      "docs/architecture-map.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": [
              "TpInput",
              "TpSelect",
              "TpTextarea",
              "TpCheckbox",
              "TpSwitch",
              "Combobox"
            ]
          }
        }
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "error"
      },
      "suspicious": {
        "noConsoleLog": "warn"
      }
    }
  },
  "overrides": [
    {
      "include": ["**/tsconfig*.json"],
      "json": { "parser": { "allowComments": true } }
    }
  ],
  "javascript": {
    "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" }
  }
}
