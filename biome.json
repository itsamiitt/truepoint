{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "ignore": [
      "**/dist",
      "**/.next",
      "**/.turbo",
      ".claude",
      ".design-sync",
      "**/src/migrations",
      "docs/architecture-map.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "organizeImports": { "enabled": true },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": {
            "inputComponents": [
              "TpInput",
              "TpSelect",
              "TpTextarea",
              "TpCheckbox",
              "TpSwitch",
              "Combobox"
            ]
          }
        }
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "error"
      },
      "suspicious": {
        "noConsoleLog": "warn"
      }
    }
  },
  "overrides": [
    {
      "include": ["**/tsconfig*.json"],
      "json": { "parser": { "allowComments": true } }
    },
    {
      "//": "noConsoleLog off where the console IS the output, not a stray debug line. Eight warnings sat here permanently: two CLI gate scripts, the extension packer, the db seed, and the two logger modules that implement logging. A rule that is 100% false positives trains you to skim past its output, which is exactly how a real stray console.log ships. Everywhere else it stays a warning.",
      "include": [
        "scripts/**",
        "**/scripts/**",
        "packages/db/src/seed.ts",
        "packages/auth/src/log.ts",
        "apps/workers/src/logger.ts",
        "apps/auth/src/lib/bootstrapAdmin.ts"
      ],
      "linter": { "rules": { "suspicious": { "noConsoleLog": "off" } } }
    }
  ],
  "javascript": {
    "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" }
  }
}
