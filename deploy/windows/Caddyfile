# Caddy — TLS termination + subdomain routing for the TruePoint preview (native Windows host).
# Same topology as deploy/Caddyfile, but upstreams are localhost ports instead of compose service names:
#   auth 3000 · api 3001 · web 3002 · admin 3003 · forge 3004 · forge-api 3005
# Certificates: Let's Encrypt, which requires the subdomain DNS A records to point at THIS server
# and ports 80+443 reachable from the internet. Caddy retries ACME until DNS/firewall are right.

{
	email amit@thecloso.com

	servers {
		trusted_proxies static private_ranges
	}
}

(site_proxy) {
	encode zstd gzip
	reverse_proxy {args[0]} {
		lb_try_duration 5s
		lb_try_interval 250ms
	}
}

auth.truepoint.in {
	import site_proxy localhost:3000
}

app.truepoint.in {
	import site_proxy localhost:3002
}

api.truepoint.in {
	import site_proxy localhost:3001
}

admin.truepoint.in {
	import site_proxy localhost:3003
}

forge.truepoint.in {
	encode zstd gzip
	@forge_api path /bff/* /v1/*
	handle @forge_api {
		reverse_proxy localhost:3005 {
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}
	handle {
		reverse_proxy localhost:3004 {
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}
}

forge-api.truepoint.in {
	import site_proxy localhost:3005
}
